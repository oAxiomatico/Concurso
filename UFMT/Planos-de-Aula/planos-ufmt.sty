\par\noindent\textbf{Registro:} Plano \underline{\hspace{1cm}}/10; desempenho \underline{\hspace{1cm}}/25; conteúdo \underline{\hspace{1cm}}/60; tempo \underline{\hspace{1cm}}/5; total \underline{\hspace{1cm}}/100.
\par\noindent\textbf{Condições de simulação:} quadro e giz/pincel; demonstrar sem consulta; não presumir intervenções da banca; reservar 5 minutos para encerrar, nunca iniciar teorema novo no fechamento.
}
